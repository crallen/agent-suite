{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.dev)",
      "Read(./.env.development)",
      "Read(./.env.prod)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.ci)",
      "Read(./.env.backup)",
      "Read(./.env.secret)",
      "Read(./.envrc)",
      "Read(./.npmrc)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.ci)",
      "Read(**/.env.backup)",
      "Read(**/.env.secret)",
      "Read(**/.envrc)",
      "Read(**/.npmrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/credentials*.json)",
      "Read(**/service-account*.json)",
      "Read(**/secrets*.yaml)",
      "Read(**/secrets*.yml)",
      "Read(**/secrets*.json)",
      "Read(**/secret.yaml)",
      "Read(**/secret.yml)",
      "Read(**/secret.json)",
      "Read(**/secrets/**)",
      "Read(~/.zsh_secrets)"
    ],
    "defaultMode": "auto"
  },
  "_hooksNote": "The PostToolUse hook asks the agent to remove any file tree it writes into a Markdown file; doc-templates holds the rule. It needs jq.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r 'select(.tool_input.file_path // \"\" | test(\"\\\\.(md|mdx|markdown)$\"; \"i\")) | [.tool_input.content, .tool_input.new_string, .tool_input.edits[]?.new_string] | map(strings) | join(\"\\n\")' | grep -qE '(├|└)──' && { echo 'This Markdown file now holds a file tree. Remove it unless the reader must create that layout: readers and agents get the layout from ls, and a copy goes stale. Describe directory roles instead: what each owns, where new work goes.' >&2; exit 2; } || exit 0"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "_promptCacheNote": "Main-conversation cache TTL is one hour on a subscription within plan usage and five minutes on an API key or usage credits; set promptCacheTtl to 1h to restore it there. Subagent TTLs are left at the five-minute default on purpose: a one-hour write costs 2x base input versus 1.25x, and only pays off when the same agent is spawned again within the hour.",
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true,
  "autoMemoryEnabled": false,
  "_shellNote": "CLAUDE_CODE_SHELL runs the Bash tool in bash whatever the login shell is. Agents write bash, and a zsh login shell breaks it (1-based arrays, no word splitting, extendedglob or nomatch carried over from the shell snapshot). /bin/bash exists on Linux and macOS alike.",
  "env": {
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_CODE_SHELL": "/bin/bash"
  }
}
